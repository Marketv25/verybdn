---
interface Props {
  lang: 'en' | 'es';
  isHome?: boolean;
}

import { business } from '../data/business';

const { lang, isHome = false } = Astro.props;
const currentYear = new Date().getFullYear();

const homePrefix = lang === 'en' ? '/' : '/es/';
const anchor = (id: string) => isHome ? `#${id}` : `${homePrefix}#${id}`;
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <span class="logo"><span class="v">very</span><span class="b">bdn</span></span>
        {lang === 'en' ? (
          <p>Applied knowledge for Colombia's Caribbean coast, written from inside it. Territory as context, narrative as tool, hospitality as real practice.</p>
        ) : (
          <p>Conocimiento aplicado sobre la costa Caribe de Colombia, escrito desde adentro. Territorio como contexto, narrativa como herramienta, hospitalidad como práctica real.</p>
        )}
      </div>
      <div class="foot-col">
        {lang === 'en' ? (
          <>
            <h4>Minca guides</h4>
            <a href="/minca/is-minca-worth-the-detour/">Is Minca worth the detour?</a>
            <a href="/minca/how-many-days/">How many days in Minca</a>
            <a href="/minca/how-to-get-to-minca/">How to get to Minca</a>
            <a href="/blog/">Writing</a>
          </>
        ) : (
          <>
            <h4>Guías de Minca</h4>
            <a href="/es/minca/vale-la-pena-el-desvio-a-minca/">¿Vale la pena el desvío a Minca?</a>
            <a href="/es/minca/cuantos-dias/">Cuántos días en Minca</a>
            <a href="/es/minca/como-llegar-a-minca/">Cómo llegar a Minca</a>
            <a href="/es/blog/">Escritos</a>
          </>
        )}
      </div>
      <div class="foot-col">
        {lang === 'en' ? (
          <>
            <h4>Legal</h4>
            <a href="/privacy/">Privacy policy</a>
            <a href="/cookies/">Cookie policy</a>
            <a href="/terms/">Terms of use</a>
            <a href="/refunds/">Cancellations &amp; refunds</a>
            <button type="button" class="foot-link-btn" data-cookie-settings>Cookie settings</button>
          </>
        ) : (
          <>
            <h4>Legal</h4>
            <a href="/es/privacidad/">Política de privacidad</a>
            <a href="/es/cookies/">Política de cookies</a>
            <a href="/es/terminos/">Términos de uso</a>
            <a href="/es/reembolsos/">Cancelaciones y reembolsos</a>
            <button type="button" class="foot-link-btn" data-cookie-settings>Configurar cookies</button>
          </>
        )}
      </div>
      <div class="foot-col">
        <h4>verybdn</h4>
        {lang === 'en' ? (
          <>
            <a href={anchor('territorio')}>The coast</a>
            <a href={anchor('como')}>How it works</a>
            <a href={anchor('lista')}>The list</a>
            <a href="https://verybdn.substack.com" target="_blank" rel="noopener noreferrer">Substack · turismo y territorio</a>
          </>
        ) : (
          <>
            <a href={anchor('territorio')}>La costa</a>
            <a href={anchor('como')}>Cómo funciona</a>
            <a href={anchor('lista')}>La lista</a>
            <a href="https://verybdn.substack.com" target="_blank" rel="noopener noreferrer">Substack · turismo y territorio</a>
          </>
        )}
      </div>
    </div>
    <div class="foot-bottom">
      <p>
        © {currentYear} verybdn · {lang === 'en' ? 'by' : 'por'} {business.legalName || business.ownerDisplayName}{business.idNumber && ` · ${business.idNumber}`} · {business.city}
        <br />WhatsApp <a href={business.whatsappLink} target="_blank" rel="noopener noreferrer">{business.whatsapp}</a>{business.email && <> · <a href={`mailto:${business.email}`}>{business.email}</a></>}
      </p>
      <span class="tag">turismo · territorio · narrativa</span>
    </div>
  </div>
</footer>
