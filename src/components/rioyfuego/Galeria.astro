---
import { Image } from 'astro:assets';
import imgCabana from '../../assets/img/galeria-01-cabana-exterior.webp';
import imgRio from '../../assets/img/galeria-02-rio.webp';
import imgSauna from '../../assets/img/galeria-03-sauna-exterior.webp';
import imgFogata from '../../assets/img/galeria-04-fogata.webp';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;

const images = [
  { src: imgCabana, alt: lang === 'en' ? 'Room with two beds seen from the terrace through open glass doors' : 'Habitación con dos camas vista desde la terraza, con las puertas de vidrio abiertas' },
  { src: imgRio, alt: lang === 'en' ? 'River running over mossy stones, surrounded by forest' : 'Río corriendo sobre piedras con musgo, rodeado de bosque' },
  { src: imgSauna, alt: lang === 'en' ? 'Inside the wooden sauna: bench, rolled towels and a plant' : 'Interior del sauna de madera: banca, toallas enrolladas y una planta' },
  { src: imgFogata, alt: lang === 'en' ? 'Stone fire pit lit at night, with floor cushions and candles around it' : 'Fogón de piedra encendido de noche, con cojines y velas alrededor' }
];
---

<section id={lang === 'en' ? 'gallery' : 'galeria'} class="wrap reveal" style="padding: 90px 28px;">
  <div class="sec-head" style="margin-bottom: 44px; max-width: 65ch;">
    <span class="eyebrow">{lang === 'en' ? 'Gallery' : 'Galería'}</span>
    <h2 style="font-family: var(--serif); font-style: normal; font-weight: 400; font-size: clamp(28px, 4vw, 42px); line-height: 1.1; margin-top: 12px;">
      {lang === 'en' ? 'Gallery' : 'Galería'}
    </h2>
    <p class="lede" style="font-family: var(--sans); font-weight: 300; font-size: 18px; color: var(--sombra); margin-top: 16px; line-height: 1.6;">
      {lang === 'en' ? 'The rooms, the river, the sauna and the fire.' : 'Las habitaciones, el río, el sauna y el fuego.'}
    </p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;">
    {images.map((img, idx) => (
      <div style="position: relative; overflow: hidden; border-radius: 4px; border: 1px solid var(--borde); aspect-ratio: 4/3; cursor: pointer; transition: transform 0.25s;">
        <Image 
          src={img.src} 
          alt={img.alt} 
          style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;" 
          width={600}
          height={450}
          loading="lazy"
          class="gal-img"
        />
        <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(26,24,20,0) 50%, rgba(26,24,20,0.65) 100%); display: flex; align-items: flex-end; padding: 16px; opacity: 0; transition: opacity 0.3s;">
          <span style="color: var(--crema); font-family: var(--sans); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;">
            {img.alt}
          </span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  div:hover .gal-img {
    transform: scale(1.04);
  }
  div:hover div {
    opacity: 1 !important;
  }
</style>
